# Copy to terraform.tfvars and adjust to your lab target.
windows_host     = "172.18.122.201"
windows_port     = 2222
windows_username = "tfacc"
# Supply WINDOWS_PASSWORD (or a WINDOWS_PRIVATE_KEY_PATH) via the environment.
# Supply TF_VAR_svc_password via the environment for the fixture local user.

test_suffix = "cli"

enable_firewall_tests         = false
enable_network_tests          = false
enable_feature_test           = false
enable_hostname_test          = false
enable_network_config_tests   = false
enable_smb_tests              = false
enable_certificate_tests      = false
enable_domain_membership_test = false
# domain_join_username = "joiner@corp.example.com"
# Supply TF_VAR_domain_join_password via the environment for the domain test.
