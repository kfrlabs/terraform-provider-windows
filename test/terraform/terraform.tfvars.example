# Copy to terraform.tfvars and adjust if your lab container differs from the
# defaults documented in test/windows-container/README.md.

windows_host     = "172.18.122.201"
windows_port     = 2222
windows_username = "tfacc"
# Supply WINDOWS_PASSWORD (or a WINDOWS_PRIVATE_KEY_PATH) via the environment.
# Supply TF_VAR_svc_password via the environment for the fixture local user.

enable_network_tests = false
enable_feature_test  = false
